{
  "name": "waterfall",
  "productName": "Waterfall",
  "license": "Apache-2.0",
  "version": "0.6.0-beta",
  "description": "Waterfall Node App",
  "main": "./out/main/index.js",
  "author": "Waterfall",
  "homepage": "https://waterfall.network",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:mac": "electron-vite build && APPLE_KEYCHAIN_PROFILE=wf-notary electron-builder --mac --config electron-builder.yml",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "bcrypto": "^5.5.2",
    "better-sqlite3": "^9.6.0",
    "electron-log": "^5.1.1",
    "electron-updater": "^6.1.8",
    "migrate": "^2.1.0",
    "node-gyp": "^9.0.0",
    "quick-lru": "^5.1.1",
    "resolve-alpn": "^1.2.0",
    "rotating-file-stream": "^3.2.1",
    "tar": "^7.0.1",
    "web3": "git+https://gitlab.waterfall.network/npm/web3js.git",
    "webidl-conversions": "^3.0.1",
    "whatwg-url": "^5.0.0"
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.0",
    "@canvasjs/react-charts": "^1.0.2",
    "@canvasjs/react-stockcharts": "^1.0.2",
    "@canvasjs/stockcharts": "^1.15.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^3.1.0",
    "@tanstack/eslint-plugin-query": "^5.20.1",
    "@tanstack/react-query": "^5.90.0",
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.0.0",
    "dayjs": "^1.11.19",
    "electron": "^29.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.2",
    "prettier": "^3.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "styled-components": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
