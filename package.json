{
  "name": "waterfall",
  "productName": "Waterfall",
  "license": "Apache-2.0",
  "version": "0.6.1-beta",
  "description": "Waterfall Node App",
  "main": "./out/main/index.js",
  "author": "Waterfall",
  "homepage": "https://waterfall.network",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:mac": "electron-vite build && APPLE_KEYCHAIN_PROFILE=wf-notary electron-builder --mac --config electron-builder.yml",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "bdui:start": "BEADS_DB=\"$PWD/.beads/dolt\" bdui start --port 5000 --open",
    "bdui:stop": "bdui stop"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "bcrypto": "^5.5.2",
    "better-sqlite3": "^12.6.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.0",
    "migrate": "^2.1.0",
    "node-gyp": "^12.2.0",
    "quick-lru": "^5.1.1",
    "resolve-alpn": "^1.2.1",
    "rotating-file-stream": "^3.2.8",
    "tar": "^7.5.7",
    "web3": "git+https://gitlab.waterfall.network/npm/web3js.git",
    "webidl-conversions": "^3.0.1",
    "whatwg-url": "^5.0.0"
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.1",
    "@canvasjs/react-charts": "^1.0.2",
    "@canvasjs/react-stockcharts": "^1.0.2",
    "@canvasjs/stockcharts": "^1.15.7",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "^3.1.1",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@tanstack/react-query": "^5.90.20",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.2.3",
    "dayjs": "^1.11.19",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "typescript-eslint": "^8.54.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "styled-components": "^6.3.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
